# Copy to .env and fill in. Only BOT_TOKEN is required.

# From @BotFather
BOT_TOKEN=

# Optional: where downloads are staged before upload (defaults to a temp dir).
# DOWNLOAD_DIR=/tmp/tgdl

# Optional: cap file size in MB. Telegram's bot upload limit is 50, so values
# above 50 are clamped to 50.
# MAX_FILESIZE_MB=50

# Optional: Netscape-format cookies.txt passed to BOTH yt-dlp and gallery-dl.
# Needed for Instagram, which blocks most anonymous access. If unset, the bot
# also auto-detects /etc/tgdl-bot/cookies.txt and ~/.config/tgdl-bot/cookies.txt.
# COOKIES_FILE=/etc/tgdl-bot/cookies.txt
